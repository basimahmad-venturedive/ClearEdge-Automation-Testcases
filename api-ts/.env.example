# automation/api-ts/.env.example  <- commit this; copy to .env locally and fill in
# CEIQ-FOUND-001 (F1) API automation — no real values here, placeholders only.

# --- Base URL (fail loud when missing — no localhost fallback) ---
API_BASE_URL=

# --- CEIQ-FEAT-008 Vendor Portal (public, unauthenticated /api/portal/:token) ---
# Origin for portal routes; if blank, the origin of API_BASE_URL is used (portal
# routes live at /api/portal, NOT under /api/v1). Placeholder only.
PORTAL_API_BASE_URL=
# The 32-byte URL-safe portal token — the sole credential (path param). Minted by the
# Sourcing invite action; the whole vendorPortal suite SKIPS-with-reason while this is blank.
PORTAL_TOKEN=
# Optional per-state seeded tokens (fall back to PORTAL_TOKEN). Uppercase the state:
# PORTAL_TOKEN_INVITED / _SUBMITTED / _WITHDRAWN / _AWARDED / _DELETED_EVENT /
# _DELETED_VENDOR / _BLOCKED_DEADLINE / _SUBMITTED_BLOCKED / _RFQ / _TENANT_A /
# _JUST_OPEN / _JUST_CLOSED
PORTAL_TOKEN_INVITED=
# Spare Cognito JWT for the "portal ignores JWT" negative case (TC-VPSEC-001). Placeholder only.
PORTAL_SPARE_COGNITO_JWT=

# --- Amazon Cognito — Tenant Pool ---
COGNITO_TENANT_USER_POOL_ID=
COGNITO_TENANT_APP_CLIENT_ID=
COGNITO_TENANT_JWKS_URI=
AWS_REGION=

# --- Amazon Cognito — Admin Pool ---
COGNITO_ADMIN_USER_POOL_ID=
COGNITO_ADMIN_APP_CLIENT_ID=
COGNITO_ADMIN_JWKS_URI=

# --- Test-only JWT signing mode ---
# local mints tokens with a disposable RSA keypair (no live Cognito needed to exercise guard shapes).
# cognito calls the real Cognito Admin API instead (requires the COGNITO_* vars above).
TEST_JWT_MODE=local

# --- ElastiCache for Redis (rights cache) ---
REDIS_HOST=
REDIS_PORT=6379

# --- Test database (direct DB assertions — RLS, audit tables; QA/staging only, never prod) ---
TEST_DATABASE_URL=

# --- Response-time SLA override (optional; default 3.0s per kit convention) ---
MAX_RESPONSE_TIME_S=3.0

# --- Mock mode (nock) ---
USE_MOCK=0

# =============================================================================
# TestRail integration (npm run testrail:import / testrail:create-run / testrail:execute)
# The result reporter matches TC-<AREA>-### ids in test titles against
# testrail/mappingStore/caseMapping.json and posts to the run in runContext.json.
# =============================================================================
TESTRAIL_INTEGRATION=0
TESTRAIL_URL=https://vdqa.testrail.io
TESTRAIL_USERNAME=<your-testrail-email>
# TestRail API key (Account Settings → API Keys) or password — NEVER commit a real value here.
# Put the real value only in automation/api-ts/.env (git-ignored).
TESTRAIL_PASSWORD=<paste-your-testrail-api-key>
TESTRAIL_PROJECT_ID=110
TESTRAIL_PROJECT_NAME=ClearEdge
TESTRAIL_RUN_NAME=ClearEdge API (Vitest) Automated Run
TESTRAIL_ENVIRONMENT=local
# testcases md used by testrail:import (relative to automation/api-ts):
TESTRAIL_TESTCASES_FILE=../../testcases/TC-CEIQ-FOUND-001.md
# ClearEdge (project 110) uses template id 5 ("BE Test Cases"); no id 6 on this instance.
TESTRAIL_TEMPLATE_ID=5
# Optional TestRail custom/result fields (leave blank unless the project requires them):
TESTRAIL_CUSTOM_QANAME=
TESTRAIL_CUSTOM_EXECUTIONERNAME=
TESTRAIL_API_TYPE_ID=15
TESTRAIL_CUSTOM_AUTOMATED_NO=0
TESTRAIL_CUSTOM_AUTOMATED_YES=1
# After publishing, trim the run to only cases that got a result so no case is
# left "Untested" (run shows only passed/failed). Default: on. Set to false to keep
# skipped/never-run cases as Untested in the run.
TESTRAIL_TRIM_UNTESTED=true

# =============================================================================
# CQM automation-stats DB (cqmReporter — inserts automation_run + test_case_execution)
# Enable with CQM_INTEGRATION=1. The reporter auto-routes:
#   • AWS path   — when AWS_* + SSH_* are all set (needs @test/integrations)
#   • Direct path — when DB_* are set (SSH tunnel + mysql2, no AWS)
# Set CQM_DIRECT_DB=1 to force direct, =0 to forbid the direct fallback.
# =============================================================================
CQM_INTEGRATION=0
CQM_TIMEZONE=Asia/Karachi
CQM_DIRECT_DB=
# Component (repo_component) — a numeric COMPONENT_ID, or a key resolved in the DB:
COMPONENT_KEY=your-component-key
COMPONENT_KEY_API=
COMMIT_ID=

# --- CQM AWS path (Secrets Manager via @test/integrations) ---
AWS_SECRET_NAME=prod/sonarmetrics/cqm_automation_qa
AWS_REGION=us-east-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# --- CQM direct path (SSH bastion + MySQL) ---
SSH_HOST=
SSH_PORT=22
SSH_USER=ubuntu
SSH_KEY_PATH=bastionhost.pem
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
