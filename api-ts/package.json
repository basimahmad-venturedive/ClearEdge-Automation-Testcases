{
  "name": "api-ts-automation",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:live": "USE_MOCK=0 vitest run",
    "test:local": "cross-env TEST_ENV=local vitest run",
    "test:dev": "cross-env TEST_ENV=dev vitest run",
    "test:dev:usermgmt": "cross-env TEST_ENV=dev vitest run tests/userManagement.test.ts",
    "test:dev:auth": "cross-env TEST_ENV=dev vitest run tests/auth.login-setpw.test.ts tests/auth.forgot-refresh-logout.test.ts",
    "test:qa": "cross-env TEST_ENV=qa vitest run",
    "test:prod": "cross-env TEST_ENV=prod vitest run",
    "local:jwks-mock": "tsx local-env/runJwksServer.ts",
    "jira:bug": "node ../scripts/jira-log-bug.mjs",
    "testrail:import": "node scripts/testrail-import.cjs",
    "testrail:prune": "node scripts/testrail-prune.cjs",
    "testrail:create-run": "node scripts/testrail-create-run.cjs",
    "testrail:execute": "node scripts/testrail-execute.cjs"
  },
  "devDependencies": {
    "@faker-js/faker": "^9.0.0",
    "@types/node": "^26.1.0",
    "@types/pg": "^8.20.0",
    "@vitest/coverage-v8": "^4.1.5",
    "axios": "^1.7.0",
    "cross-env": "^10.1.0",
    "dotenv": "^16.4.0",
    "ioredis": "^5.4.0",
    "jose": "^5.9.0",
    "nock": "^13.5.0",
    "pg": "^8.12.0",
    "tsx": "^4.23.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.5",
    "zod": "^3.23.0"
  },
  "dependencies": {
    "mysql2": "^3.11.4",
    "ssh2": "^1.16.0"
  },
  "optionalDependencies": {
    "@test/integrations": "^1.7.73"
  }
}
