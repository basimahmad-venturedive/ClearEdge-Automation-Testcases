# automation/api-ts/envs/.env.qa — QA target (TEST_ENV=qa). Git-ignored.
# NOTE: the typed accessors in src/config/env.ts read DEV_*-prefixed keys regardless
# of environment (the file is chosen by TEST_ENV, the key names stay the same), so QA
# values go under the DEV_* keys below. (The old QA_TEST_* names in .env.qa.example are
# stale and are NOT read by the code.)

# --- Base URLs (QA) ---
API_BASE_URL=https://api-qa.clearedgeiq.com/api/v1
HEALTH_BASE_URL=https://api-qa.clearedgeiq.com
AWS_REGION=us-east-1

# --- QA Cognito (public identifiers — NOT in the repo; get from the QA deployment's
#     GitHub Actions `vars.*`, the AWS Cognito console, or the deployed app bundle) ---
COGNITO_TENANT_USER_POOL_ID=us-east-1_lKr1J7RCo
COGNITO_TENANT_APP_CLIENT_ID=6q29d5f3n048i1l57otdod102b
COGNITO_ADMIN_USER_POOL_ID=us-east-1_fjdhLcVmC
COGNITO_ADMIN_APP_CLIENT_ID=37vbeojhfbgb15v6bc747f30lk

