# automation/api-ts/envs/.env.qa.example  <- commit this; copy to .env.qa and fill in
# Target: shared QA deployment of clearedge-backend. NOT YET PROVISIONED (2026-07-07) —
# placeholders only until a QA environment + real Cognito QA pool exist.

API_BASE_URL=https://api.qa.clearedgeiq.example/api/v1
HEALTH_BASE_URL=https://api.qa.clearedgeiq.example

# QA uses real Cognito (Admin API-provisioned test users), not the local JWKS mock.
COGNITO_TENANT_USER_POOL_ID=
COGNITO_TENANT_APP_CLIENT_ID=
COGNITO_ADMIN_USER_POOL_ID=
COGNITO_ADMIN_APP_CLIENT_ID=
AWS_REGION=

# QA-only test accounts for minting real tokens via Cognito Admin API (never real prod users).
QA_TEST_PLATFORM_ADMIN_USERNAME=
QA_TEST_PLATFORM_ADMIN_PASSWORD=
QA_TEST_TENANT_OWNER_USERNAME=
QA_TEST_TENANT_OWNER_PASSWORD=

TEST_DATABASE_URL=
REDIS_HOST=
REDIS_PORT=6379

MAX_RESPONSE_TIME_S=3.0
USE_MOCK=0
