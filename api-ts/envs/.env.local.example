# automation/api-ts/envs/.env.local.example  <- commit this; copy to .env.local and fill in
# Target: clearedge-backend running locally (native Postgres + WSL Redis + local JWKS mock).

API_BASE_URL=http://localhost:3000/api/v1
HEALTH_BASE_URL=http://localhost:3000

# Local Cognito mock (automation/api-ts/local-env/) — matches the backend's
# COGNITO_TENANT_JWKS_URI / COGNITO_ADMIN_JWKS_URI when pointed at this mock.
TENANT_POOL_JWKS_URI=http://localhost:4001/tenant-pool/.well-known/jwks.json
ADMIN_POOL_JWKS_URI=http://localhost:4001/admin-pool/.well-known/jwks.json
TENANT_POOL_ISSUER=http://localhost:4001/tenant-pool
ADMIN_POOL_ISSUER=http://localhost:4001/admin-pool

# Direct DB access for RLS / audit-table assertions — same DB the backend uses locally.
TEST_DATABASE_URL=postgresql://clearedge:clearedge@localhost:5432/clearedge

# Direct Redis access for rights-cache assertions (WSL redis-server, forwarded to localhost).
REDIS_HOST=localhost
REDIS_PORT=6379

MAX_RESPONSE_TIME_S=3.0
USE_MOCK=0
