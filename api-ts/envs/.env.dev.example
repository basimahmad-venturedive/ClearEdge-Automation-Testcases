# automation/api-ts/envs/.env.dev.example  <- commit this; copy to .env.dev and fill in.
# Target: dev deployment of clearedge-backend. Auth is real Cognito (admin pool) —
# tokens are minted via Cognito InitiateAuth (USER_PASSWORD_AUTH), the same flow the
# admin frontend uses. The backend accepts the Cognito ID token as the Bearer.

API_BASE_URL=https://<dev-api>.cloudfront.net/api/v1
HEALTH_BASE_URL=https://<dev-api>.cloudfront.net

# --- Cognito (public app-client config; read from the deployed admin SPA bundle) ---
AWS_REGION=us-east-1
COGNITO_ADMIN_USER_POOL_ID=
COGNITO_ADMIN_APP_CLIENT_ID=
COGNITO_TENANT_USER_POOL_ID=
COGNITO_TENANT_APP_CLIENT_ID=

# --- Platform-admin test user provisioned in the dev admin Cognito pool ---
# Must be a finalised user (no pending NEW_PASSWORD_REQUIRED challenge).
DEV_ADMIN_USERNAME=
DEV_ADMIN_PASSWORD=

# Leave TEST_DATABASE_URL unset unless dev Postgres is reachable (e.g. via bastion tunnel).
# When unset, direct-DB assertions/fixtures are skipped on dev (hasDbAccess() === false).
# TEST_DATABASE_URL=

MAX_RESPONSE_TIME_S=3.0
USE_MOCK=0
