# automation/api-ts/envs/.env.dev.example  <- commit this; copy to .env.dev and fill in.
# Target: dev deployment of clearedge-backend. Auth is real Cognito (admin pool) —
# tokens are minted via Cognito InitiateAuth (USER_PASSWORD_AUTH), the same flow the
# admin frontend uses. The backend accepts the Cognito ID token as the Bearer.

API_BASE_URL=https://api-dev.clearedgeiq.com/api/v1
HEALTH_BASE_URL=https://api-dev.clearedgeiq.com

# --- Cognito (public config, from the deployed admin SPA bundle, 2026-07-14) ---
AWS_REGION=us-east-1
# Admin pool — tokenProvider mints the admin ID token against this app client.
COGNITO_ADMIN_USER_POOL_ID=us-east-1_SKdsA1tH5
COGNITO_ADMIN_APP_CLIENT_ID=47lumg1f8d1p41tovu0qvkh0am
# Tenant pool — recorded for when a tenant test user exists (not used yet on dev).
COGNITO_TENANT_USER_POOL_ID=us-east-1_CELlo48Tt
COGNITO_TENANT_APP_CLIENT_ID=uofce2ddnbobd2uphgnfe5hdo

# --- Platform-admin test user (dev admin Cognito pool) ---
DEV_ADMIN_USERNAME=basim.navaid@venturedive.com
DEV_ADMIN_PASSWORD=__set_in_jenkins_CLEAREDGE_DEV_ADMIN_PASSWORD__

# --- Tenant-pool test user (tenant Cognito pool) ---
DEV_TENANT_USERNAME=zubair.amin+01@venturedive.com
DEV_TENANT_PASSWORD=__set_in_jenkins_CLEAREDGE_DEV_TENANT_PASSWORD__

# No TEST_DATABASE_URL on dev — RDS is not reachable from here. Its ABSENCE is the
# signal (hasDbAccess() === false) that direct-DB assertions/fixtures skip on dev.

MAX_RESPONSE_TIME_S=3.0
USE_MOCK=0

