# automation/integration/testrail/.env.example
# Copy to automation/integration/testrail/.env and fill in real values.
# NEVER commit the real .env (see .claude/rules/secrets-and-env.rules.md).
# These are read only through testrail_settings.py — never hardcode in source.

# TestRail instance base URL (no trailing /index.php).
TESTRAIL_URL=https://your-instance.testrail.io

# TestRail account email + API key (Account Settings > API Keys).
# The API key is used as the HTTP Basic password.
TESTRAIL_USERNAME=zubair.amin@venturedive.com
TESTRAIL_PASSWORD=<paste-your-testrail-api-key>

# Numeric project and suite ids the cases are published into.
TESTRAIL_PROJECT_ID=1
TESTRAIL_SUITE_ID=1

# template_id applied to cases whose Module / Layer mentions API
# (often 5 or 6 in a "Test Case (Steps)" configuration — confirm in your
# instance; leave unset to use the project default template).
TESTRAIL_API_TEMPLATE_ID=6
