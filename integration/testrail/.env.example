# automation/integration/testrail/.env.example  <- commit this; copy to .env locally and fill in
TESTRAIL_URL=https://your-instance.testrail.io
TESTRAIL_USERNAME=your@email.com
TESTRAIL_PASSWORD=your-api-key
TESTRAIL_PROJECT_ID=1
TESTRAIL_SUITE_ID=1
TESTRAIL_API_TEMPLATE_ID=6
TESTRAIL_INTEGRATION=0
TESTRAIL_RUN_SUITE_NAME=
TESTRAIL_RUN_TIMEZONE=Asia/Karachi
TESTRAIL_RUN_TIMEZONE_LABEL=PKT
TESTRAIL_RESULT_COMMENT=Automated pytest pass
