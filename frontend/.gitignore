# Secrets / local configuration — never committed (.claude/rules/secrets-and-env.rules.md §6)
# Covers .env plus every per-environment file (.env.local/.env.dev/.env.qa/.env.prod);
# only the committed .env.example template is exempt.
.env
.env.*
!.env.example
storageState.json
playwright/.auth/

# Dependencies
node_modules/

# Run artifacts
test-results/
playwright-report/
blob-report/
reports/
logs/
coverage/

# Vendor-portal fixture — LIVE QA invitation tokens (each one is a credential that opens
# a real vendor's portal), regenerated by api-ts/scripts/seed-portal-fixture.ts, plus the
# single-use cursor over its invited pool. Both are per-run state, never committed.
portal-fixture.json
.portal-pool-cursor.json
ui-token.txt
