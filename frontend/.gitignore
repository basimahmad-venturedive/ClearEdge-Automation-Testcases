# Secrets / local configuration — never committed (.claude/rules/secrets-and-env.rules.md §6)
# Covers .env plus every per-environment file (.env.local/.env.dev/.env.qa/.env.prod);
# only the committed .env.example template is exempt.
.env
.env.*
!.env.example
storageState.json
playwright/.auth/

# Dependencies
node_modules/

# Run artifacts
test-results/
playwright-report/
blob-report/
reports/
logs/
coverage/
