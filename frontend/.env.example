# automation/frontend/.env.example — committed template with PLACEHOLDERS ONLY.
# Copy to automation/frontend/.env and fill in real values (the real .env is git-ignored,
# see .claude/rules/secrets-and-env.rules.md). Never commit a filled-in .env.

# E2E_BASE_URL — base URL of the ClearEdgeIQ ADMIN PORTAL that Playwright opens.
# REQUIRED: playwright.config.ts fails loud at config time when this is missing.
# There is NO localhost fallback. As of 2026-07-08 the admin portal frontend is
# not yet deployed — obtain the URL from the CEIQ-FEAT-001 frontend team.
E2E_BASE_URL=https://admin.example.test

# PA_EMAIL / PA_PASSWORD — Platform Admin credentials in the Cognito ADMIN pool
# (SPEC_CEIQ-FEAT-001 §2.4 / §8.2). Obtain from the team password vault; never
# paste into source, chat, or tickets. Tests that need an authenticated session
# skip with a clear message when these are missing.
PA_EMAIL=platform.admin@example.test
PA_PASSWORD=replace-me

# =============================================================================
# TestRail integration (npm run testrail:import / testrail:create-run / testrail:execute)
# When TESTRAIL_INTEGRATION=1, the Playwright reporter matches TC-<AREA>-### ids
# in spec titles against testrail/mappingStore/caseMapping.json and posts results
# to the run in testrail/mappingStore/runContext.json.
# =============================================================================
TESTRAIL_INTEGRATION=0
TESTRAIL_URL=https://vdqa.testrail.io
TESTRAIL_USERNAME=your-email@venturedive.com
TESTRAIL_PASSWORD=your-testrail-api-key
TESTRAIL_PROJECT_ID=110
TESTRAIL_PROJECT_NAME=ClearEdge
TESTRAIL_RUN_NAME=ClearEdge UI (Playwright) Automated Run
TESTRAIL_ENVIRONMENT=local
# testcases md used by testrail:import (relative to automation/frontend):
TESTRAIL_TESTCASES_FILE=../../testcases/TC-CEIQ-FEAT-001.md

# =============================================================================
# CQM automation-stats DB (cqmReporter — inserts automation_run + test_case_execution)
# Enable with CQM_INTEGRATION=1. The frontend reporter uses the AWS Secrets
# Manager path (@test/integrations); fill in AWS_* + SSH_* below.
# =============================================================================
CQM_INTEGRATION=0
CQM_TIMEZONE=Asia/Karachi
# Component (repo_component) — a numeric COMPONENT_ID, or a key resolved in the DB:
COMPONENT_KEY=your-component-key
COMPONENT_KEY_UI=
COMMIT_ID=
AWS_SECRET_NAME=prod/sonarmetrics/cqm_automation_qa
AWS_REGION=us-east-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
SSH_HOST=
SSH_PORT=22
SSH_USER=ubuntu
SSH_KEY_PATH=bastionhost.pem
