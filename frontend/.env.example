# automation/frontend/.env.example — committed template with PLACEHOLDERS ONLY.
#
# This suite supports FOUR environments: local, dev, qa, prod.
# Per-environment switching is done by SELECTING A DIFFERENT .env FILE (never by
# `if (env === …)` branches in code — see .claude/rules/secrets-and-env.rules.md §1a).
#
#   TEST_ENV=<env>  →  loads  automation/frontend/.env.<env>
#
#   local → .env.local     dev → .env.dev     qa → .env.qa     prod → .env.prod
#
# Create one file per environment you run against by copying THIS template:
#   cp .env.example .env.dev      # then fill in dev values
#   cp .env.example .env.qa       # then fill in qa values   … etc.
# All .env / .env.<env> files are git-ignored; only this .env.example is committed.
#
# Select the environment when running (default is `local`):
#   TEST_ENV=dev npm test                 # bash / CI
#   $env:TEST_ENV='dev'; npm test         # PowerShell (Windows)
#
# A missing base URL FAILS LOUD at config time (no localhost fallback). A missing
# credential SKIPS the affected tests with a message naming the variable + file.

# =============================================================================
# Base URLs — one pair per environment file (.env.local / .env.dev / .env.qa / .env.prod)
# =============================================================================

# E2E_BASE_URL — base URL of the ClearEdgeIQ ADMIN PORTAL that Playwright opens
# (this is the Playwright `baseURL`). REQUIRED: playwright.config.ts fails loud
# at config time when this is missing for the selected environment.
E2E_BASE_URL=https://admin.example.test

# APP_BASE_URL — base URL of the ClearEdge tenant-facing APPLICATION (distinct
# from the admin portal). Used by flows that cross into the main app. Read via
# utils/env.ts::appBaseUrl(). REQUIRED for any test that opens the app.
# The CEIQ-FEAT-008 Vendor Portal (/portal/:token) also resolves against this host.
APP_BASE_URL=https://app.example.test

# PORTAL_TOKEN — a seeded Vendor-Portal invitation token for the unauthenticated
# /portal/:token route (CEIQ-FEAT-008 ASM-01). This is the SOLE access credential
# for the portal; it is minted by the Sourcing "invite vendor" action (SRC-06), not
# deployed. Read via utils/env.ts::portalToken(); presence is checked by
# hasPortalEnv(). LEAVE BLANK until a token can be seeded — tests/vendor-portal.spec.ts
# skips its whole suite cleanly when this is absent (no confirmed portal env yet).
PORTAL_TOKEN=

# ADMIN_API_BASE_URL — origin of the admin BACKEND API (the SPA calls
# /api/v1/admin/* here; on dev/prod it's a separate host from the SPA). Read via
# utils/env.ts::adminApiBaseUrl(). REQUIRED by the API seeding harness
# (utils/adminApi.ts) that creates controlled tenant data for data-dependent tests.
ADMIN_API_BASE_URL=https://admin-api.example.test

# =============================================================================
# Platform Admin credentials — SECRETS, per environment (Cognito ADMIN pool,
# SPEC_CEIQ-FEAT-001 §2.4 / §8.2). Obtain from the team password vault; never
# paste into source, chat, or tickets. Tests that need an authenticated session
# skip with a clear message when these are missing.
# =============================================================================
PA_EMAIL=platform.admin@example.test
PA_PASSWORD=replace-me

# =============================================================================
# Tenant-app procurement role credentials — SECRETS, per environment (Cognito
# TENANT pool). Each drives a Playwright PROJECT that loads that role's saved
# session; a project auto-skips when its creds are absent, so CI can run a
# subset. PO powers the FEAT-003/004/005/006/007 owner suites; PM + ANALYST
# power the FEAT-007 Sourcing role-based-access specs (manager parity /
# view-only). Obtain from the team vault; never paste real values here.
#   PO      = view_* + manage_* (Procurement Owner)
#   PM      = manage_sourcing parity with the Owner (Procurement Manager)
#   ANALYST = view_sourcing only, no manage_* (Procurement Analyst)
# =============================================================================
PO_EMAIL=procurement.owner@example.test
PO_PASSWORD=replace-me
PM_EMAIL=procurement.manager@example.test
PM_PASSWORD=replace-me
ANALYST_EMAIL=procurement.analyst@example.test
ANALYST_PASSWORD=replace-me

# Jira bug logging lives at the shared automation level now — see
# automation/.env.example and automation/scripts/jira-log-bug.mjs. Put JIRA_*
# credentials in automation/.env (not here) so both API + frontend can use them.

# =============================================================================
# TestRail integration (npm run testrail:import / testrail:create-run / testrail:execute)
# When TESTRAIL_INTEGRATION=1, the Playwright reporter matches TC-<AREA>-### ids
# in spec titles against testrail/mappingStore/caseMapping.json and posts results
# to the run in testrail/mappingStore/runContext.json.
# These are non-URL/shared knobs — they can live in a shared `.env` too.
# =============================================================================
TESTRAIL_INTEGRATION=0
TESTRAIL_URL=https://vdqa.testrail.io
TESTRAIL_USERNAME=your-email@venturedive.com
TESTRAIL_PASSWORD=your-testrail-api-key
TESTRAIL_PROJECT_ID=110
TESTRAIL_PROJECT_NAME=ClearEdge
TESTRAIL_RUN_NAME=ClearEdge UI (Playwright) Automated Run
# Set this to match the environment you executed against (local / dev / qa / prod):
TESTRAIL_ENVIRONMENT=dev
# testcases md used by testrail:import (relative to automation/frontend):
TESTRAIL_TESTCASES_FILE=../../testcases/TC-CEIQ-FEAT-001.md

# =============================================================================
# CQM automation-stats DB (cqmReporter — inserts automation_run + test_case_execution)
# Enable with CQM_INTEGRATION=1. The frontend reporter uses the AWS Secrets
# Manager path (@test/integrations); fill in AWS_* + SSH_* below.
# =============================================================================
CQM_INTEGRATION=0
CQM_TIMEZONE=Asia/Karachi
# Component (repo_component) — a numeric COMPONENT_ID, or a key resolved in the DB:
COMPONENT_KEY=your-component-key
COMPONENT_KEY_UI=
COMMIT_ID=
AWS_SECRET_NAME=prod/sonarmetrics/cqm_automation_qa
AWS_REGION=us-east-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
SSH_HOST=
SSH_PORT=22
SSH_USER=ubuntu
SSH_KEY_PATH=bastionhost.pem
