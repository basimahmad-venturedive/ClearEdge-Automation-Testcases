{
  "name": "clearedgeiq-admin-portal-e2e",
  "version": "0.1.0",
  "private": true,
  "description": "Playwright UI automation for CEIQ-FEAT-001 Admin Portal (testcases/TC-CEIQ-FEAT-001.md)",
  "scripts": {
    "clean:reports": "node scripts/clean-playwright-reports.mjs",
    "test": "npm run clean:reports && playwright test",
    "test:headed": "npm run clean:reports && playwright test --headed",
    "test:local": "node scripts/run-env.mjs local",
    "test:dev": "node scripts/run-env.mjs dev",
    "test:spec": "node scripts/run-by-spec.mjs",
    "test:dev:usermgmt": "node scripts/run-env.mjs dev tests/user-management-home.spec.ts",
    "test:dev:auth": "node scripts/run-env.mjs dev tests/login.spec.ts",
    "test:qa": "node scripts/run-env.mjs qa",
    "test:prod": "node scripts/run-env.mjs prod",
    "test:regression:dev": "node scripts/run-env.mjs dev --grep @regression",
    "test:smoke:dev": "node scripts/run-env.mjs dev --grep @smoke",
    "test:regression:qa": "node scripts/run-env.mjs qa --grep @regression",
    "test:smoke:qa": "node scripts/run-env.mjs qa --grep @smoke",
    "jira:bug": "node ../scripts/jira-log-bug.mjs",
    "testrail:import": "node scripts/testrail-import.js",
    "testrail:create-run": "node scripts/testrail-create-run.js",
    "testrail:execute": "node scripts/testrail-execute.js",
    "test:qa:clause": "node scripts/run-env.mjs qa tests/clause-config-view.spec.ts",
    "test:qa:vendor": "node scripts/run-env.mjs qa tests/vendors-add.spec.ts",
    "test:qa:setup": "node scripts/run-env.mjs qa --project=setup"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@types/node": "^22.10.0",
    "axios": "^1.15.2",
    "dotenv": "^16.4.5",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "mysql2": "^3.22.3",
    "ssh2": "^1.17.0"
  },
  "optionalDependencies": {
    "@test/integrations": "^1.7.73"
  }
}
