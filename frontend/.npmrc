# The CQM AWS path uses @test/integrations from the VentureDive private registry.
# It is an optionalDependency, so npm install still succeeds when the registry is
# unreachable. Provide the auth token via the VD_NPM_TOKEN env var — never commit
# a real token.
@test:registry=http://vdnpmreg.internal.venturedive.com:4873/
//vdnpmreg.internal.venturedive.com:4873/:_authToken=${VD_NPM_TOKEN}
always-auth=true
registry=https://registry.npmjs.org/
