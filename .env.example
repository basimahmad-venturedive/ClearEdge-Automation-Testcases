# automation/.env.example — shared automation config (copy to automation/.env, git-ignored).
# Currently holds Jira bug-logging credentials used by the shared logger
# (automation/scripts/jira-log-bug.mjs), usable from both the API and frontend layers.
# Never commit a filled-in .env — PLACEHOLDERS ONLY here (see .claude/rules/secrets-and-env.rules.md).

# =============================================================================
# Jira bug logging
#   node automation/scripts/jira-log-bug.mjs "<path-to-bug.md>" [--dry-run]
#   (or `npm run jira:bug -- "<path>"` from automation/frontend or automation/api-ts)
# =============================================================================
JIRA_BASE_URL=https://your-org.atlassian.net
JIRA_PROJECT_KEY=CEIQ
# Jira Cloud: set JIRA_EMAIL + an API token (id.atlassian.com → API tokens) → Basic auth.
# Jira Server/DC: leave JIRA_EMAIL blank and put a Personal Access Token in JIRA_API_TOKEN → Bearer.
JIRA_EMAIL=your-email@venturedive.com
JIRA_API_TOKEN=replace-me
JIRA_ISSUE_TYPE=Bug
# API version: "3" for Cloud (ADF description), "2" for Server/DC (plain text).
JIRA_API_VERSION=3
JIRA_LABELS=qa-automation
