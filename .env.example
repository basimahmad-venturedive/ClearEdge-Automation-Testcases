# Environment
ENV=qa
BASE_URL=https://qa.clearedgeiq.com
API_BASE_URL=https://api-qa.clearedgeiq.com

# Login credentials (never commit real values)
VALID_USER_EMAIL=procurement.owner@example.com
VALID_USER_PASSWORD=YourSecurePassword123!
INVALID_USER_EMAIL=invalid@example.com
INVALID_USER_PASSWORD=WrongPassword123!

# Browser
HEADLESS=true
SLOW_MO=0
TIMEOUT=30000

# Reporting
ENABLE_EXTENT=true
ENABLE_TESTRAIL=false

# TestRail
TESTRAIL_URL=https://yourcompany.testrail.io
TESTRAIL_USERNAME=your.email@company.com
TESTRAIL_API_KEY=your-api-key
TESTRAIL_PROJECT_ID=1
TESTRAIL_SUITE_ID=1

# Retry
RETRY_COUNT=1
